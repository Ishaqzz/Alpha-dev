{
  "expo": {
    "name": "Alphaandroid",
    "slug": "alphaandroid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpeg",
    "scheme": "alphaandroid",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohamedishaq.alphaandroid"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.jpeg",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.mohamedishaq.alphaandroid",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https"
            },
            {
              "scheme": "whatsapp"
            }
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https"
            },
            {
              "scheme": "whatsapp"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.jpeg"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.jpeg",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7ef671a-2e36-4223-a3f5-8d0ceffa4afd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e7ef671a-2e36-4223-a3f5-8d0ceffa4afd"
    }
  }
}
